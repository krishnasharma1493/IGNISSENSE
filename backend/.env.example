# Copy to .env and fill in. Defaults shown are what src/config/index.ts falls
# back to when the variable is unset.

NODE_ENV=development
PORT=5001

# Serve fixture data instead of hitting live FIRMS. Default false.
DEMO_MODE=false

# When false (the default) the server refuses to start if MongoDB is
# unreachable, rather than silently spinning up an in-memory database and
# serving seeded data as if it were live. Only set true for offline demos.
ALLOW_EPHEMERAL_DB=false

# MongoDB. Register at https://cloud.mongodb.com (free tier) or run locally.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# CORS. CORS_ORIGINS is comma-separated.
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# NASA FIRMS. Free MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key
# The code reads FIRMS_MAP_KEY first and falls back to FIRMS_API_KEY.
# Quota is 5000 transactions per 10 minutes per key; the ingestion loop polls
# 4 sensors every 5 minutes while the server runs.
FIRMS_MAP_KEY=<your_map_key>
FIRMS_API_BASE_URL=https://firms.modaps.eosdis.nasa.gov

# Overpass, for OSM tile extraction (no key required).
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Nominatim reverse geocoding. The OSM usage policy requires a real
# identifying User-Agent and caps requests at 1/second.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=IGNISSENSE/1.0 (SIH 2026 26162)

# Python inference service (ml/src/inference/service.py). If this is down the
# backend does not fail: it returns other_or_uncertain at 0.50 confidence and
# suffixes the model version with -OFFLINE.
MODEL_SERVICE_URL=http://localhost:8000

# Training only. Used by scripts under src/scripts/training/ against a LOCAL
# mongod; trainingDb.ts refuses any non-local or production URI.
# TRAINING_MONGODB_URI=mongodb://127.0.0.1:27018/ignissense_training
