NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
# Register at https://cloud.mongodb.com (free tier)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# NASA FIRMS API
# Register for free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_API_KEY=<your_map_key>
FIRMS_API_BASE_URL=https://firms.modaps.eosdis.nasa.gov

# Overpass API (no key required)
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# ML inference service (if using live inference)
MODEL_SERVICE_URL=http://localhost:8000
