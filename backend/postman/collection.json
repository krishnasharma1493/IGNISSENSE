{
  "info": {
    "name": "SIH 26162 Industrial Fire Detection",
    "description": "API collection for SIH 2026 Problem Statement 26162.\nAI-Based Detection and Classification of Industrial Fires and Persistent Thermal Sources.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "health"]
            },
            "description": "Returns service status."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => { pm.expect(pm.response.code).to.equal(200); });",
                  "pm.test('Response has success flag', () => { const json = pm.response.json(); pm.expect(json.success).to.be.true; });",
                  "pm.test('Data contains status ok', () => { const json = pm.response.json(); pm.expect(json.data.status).to.equal('ok'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Hotspots",
      "item": [
        {
          "name": "List Hotspots",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/hotspots?region=delhi_ncr&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "hotspots"],
              "query": [
                { "key": "region", "value": "delhi_ncr" },
                { "key": "limit", "value": "50" }
              ]
            },
            "description": "List hotspots with optional filters: startDate, endDate, minConfidence, bbox, region, limit."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => { pm.expect(pm.response.code).to.equal(200); });",
                  "pm.test('Response has success flag', () => { pm.expect(pm.response.json().success).to.be.true; });",
                  "pm.test('Response contains hotspots array', () => { pm.expect(pm.response.json().data.hotspots).to.be.an('array'); });",
                  "if (pm.response.json().data.hotspots.length > 0) { pm.environment.set('hotspotId', pm.response.json().data.hotspots[0]._id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Hotspot Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/hotspots/{{hotspotId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "hotspots", "{{hotspotId}}"]
            },
            "description": "Get complete hotspot details by ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => { pm.expect(pm.response.code).to.equal(200); });",
                  "pm.test('Response has hotspot data', () => { const json = pm.response.json(); pm.expect(json.success).to.be.true; pm.expect(json.data).to.exist; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Hotspot - Invalid ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/hotspots/invalid_id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "hotspots", "invalid_id"]
            },
            "description": "Test invalid ID handling."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => { pm.expect(pm.response.code).to.equal(400); });",
                  "pm.test('Response has error', () => { pm.expect(pm.response.json().success).to.be.false; });"
                ]
              }
            }
          ]
        }
      ]
    },
