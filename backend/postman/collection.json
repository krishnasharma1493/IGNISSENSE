    {
      "name": "Classification",
      "item": [
        {
          "name": "Get Classification",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/classifications/{{hotspotId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "classifications", "{{hotspotId}}"]
            },
            "description": "Get classification result for a hotspot."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => { pm.expect(pm.response.code).to.equal(200); });",
                  "pm.test('Classification has required fields', () => { const d = pm.response.json().data; pm.expect(d.predictedClass).to.exist; pm.expect(d.confidence).to.exist; pm.expect(d.classProbabilities).to.exist; pm.expect(d.persistenceScore).to.exist; pm.expect(d.anomalyScore).to.exist; pm.expect(d.explanation).to.be.an('array'); });"
                ]
              }
            }
          ]
        }
      ]
    },
