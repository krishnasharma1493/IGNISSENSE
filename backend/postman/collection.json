    {
      "name": "Ingestion",
      "item": [
        {
          "name": "FIRMS Ingestion",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sensor\": \"VIIRS_SNPP_NRT\",\n  \"dayRange\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ingestion/firms",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ingestion", "firms"]
            },
            "description": "Trigger FIRMS data ingestion for Delhi NCR."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is successful', () => { pm.expect(pm.response.code).to.be.oneOf([200, 201, 503]); });"
                ]
              }
            }
          ]
        }
      ]
    }
